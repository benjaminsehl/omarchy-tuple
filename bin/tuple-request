#!/bin/bash
# tuple-request ARG... — send one request straight to the Tuple daemon and print
# its reply, without going through the `tuple` CLI.
#
# Why: the daemon writes replies with non-blocking sends and drops the rest on
# EAGAIN ("write to deferred ls pipe failed, error=11"). The stock CLI drains
# its socket slowly, so `tuple ls` on a large org directory comes back cut off
# (71 of ~7,800 rows here). socat with a big buffer, spooled to a file, keeps
# up. It also never spawns the daemon, which `tuple` does for any command.
#
# Wire format (see Model.js): u64 LE byteLength, u64 LE argc, then each arg
# NUL-terminated.
set -euo pipefail
export LC_ALL=C

command -v socat >/dev/null 2>&1 || { echo "tuple-request: socat not installed" >&2; exit 127; }
grep -qs '@tuple-daemon' /proc/net/unix || { echo "tuple-request: daemon not running" >&2; exit 3; }

le64() {
  local v=$1 i out=""
  for i in 0 1 2 3 4 5 6 7; do out+=$(printf '\\x%02x' $(( (v >> (8 * i)) & 255 ))); done
  printf "$out"
}

len=0
for a in "$@"; do len=$(( len + ${#a} + 1 )); done

spool=$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/tuple-request.XXXXXX")
trap 'rm -f "$spool"' EXIT

{ le64 "$len"; le64 "$#"; for a in "$@"; do printf '%s\0' "$a"; done; } |
  socat -b 4194304 -t 30 -T 60 - ABSTRACT-CONNECT:tuple-daemon >"$spool"

cat "$spool"
